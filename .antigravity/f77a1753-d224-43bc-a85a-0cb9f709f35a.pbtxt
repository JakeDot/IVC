ubmit();});if (btnAttachFile && chatFileInput) {    btnAttachFile.addEventListener(\'click\', () => chatFileInput.click());    chatFileInput.addEventListener(\'change\', handleShareFileSelect);}btnRefreshStats.addEventListener(\'click\', loadConnectionStats);"
