ss=\"top-bar\">\n            <div class=\"brand\">\n                <span class=\"shield-icon\">\360\237\217\260</span>\n                <h1>IVC<span class=\"highlight\">WebRTC</span> <span style=\"font-size: 0.8rem; font-weight: normal; opacity: 0.8;\">IRC Infrastructure</span></h1>\n            </div>\n            <div class=\"header-controls\">\n                <div class=\"security-badges\">\n                    <span class=\"badge green\">\342\232\241 PHP 8.5 & MySQL</span>\n                    <span class=\"badge shield\">\360\237\224\221 NAMESERV / CHANSERV</span>\n                    <span class=\"badge purple\">\360\237\225\265\357\270\217 #room Hash Channels</span>\n                    <span class=\"badge blue\">\360\237\223\212 #stats Room</span>\n                </div>\n                <div class=\"theme-selector-wrapper\">\n                    <label for=\"theme-select\">\360\237\216\250 Theme:</label>\n                    <select id=\"theme-select\" class=\"theme-select\">\n                        <option value=\"dark\">\360\237\214\231 Dark (Default)</option>\n                        <option value=\"light\">\342\230\200\357\270\217 Light</option>\n                        <option value=\"halloween\">\360\237\216\203 Halloween</option>\n                        <option value=\"console\">\360\237\223\237 Console</option>\n                        <option value=\"christmas\">\360\237\216\204 Christmas</option>\n                        <option value=\"manage-custom\" style=\"font-weight: bold;\">\342\236\225 Custom Themes...</option>\n                    </select>\n                </div>\n                <button id=\"btn-theme-modal\" class=\"btn-custom-theme\" title=\"Manage Custom Themes\">\360\237\216\250 Custom</button>\n            </div>\n        </header>\n\n        <!-- IRC Channel Tabs Navigation Bar -->\n        <nav class=\"tabs-nav-container\">\n            <div class=\"tabs-bar\" id=\"tabs-bar\">\n                <!-- Dynamically populated room tabs -->\n            </div>\n            <button id=\"btn-open-new-tab\" class=\"btn btn-sm btn-primary\" title=\"Join or Open Channel\">\342\236\225 Open #channel</button>\n        </nav>\n\n        <!-- Main Grid Layout -->\n        <main class=\"main-content\">\n            <!-- Room Lobby / Open Channel Panel -->\n            <section id=\"room-lobby\" class=\"card lobby-card\">\n                <h2>Join or Create Anonymous IRC Video Channel</h2>\n                <p class=\"subtitle\">Direct Peer-to-Peer encrypted communication. Share via <code>domain.com/#&lt;channel&gt;</code> (e.g. <code>#lobby</code>, <code>#general</code>).</p>\n\n                <div class=\"lobby-controls\">\n                    <div class=\"input-row\">\n                        <div class=\"input-group\">\n                            <label for=\"room-input\">Channel Name (Scheme: domain.com/#&lt;channel&gt;)</label>\n                            <input type=\"text\" id=\"room-input\" value=\"\" placeholder=\"e.g. #general, #fortress\" autocomplete=\"off\" spellcheck=\"false\">\n                        </div>\n                        <div class=\"input-group\">\n                            <label for=\"key-input\">Channel Passkey (Optional)</label>\n                            <input type=\"text\" id=\"key-input\" placeholder=\"Optional CHANSERV key\" autocomplete=\"off\" spellcheck=\"false\">\n                        </div>\n                    </div>\n\n                    <div class=\"input-row\">\n                        <div class=\"input-group\">\n                            <label for=\"nickname-input\">Your IRC Nickname (Generated or Custom)</label>\n                            <div class=\"nickname-box\">\n                                <input type=\"text\" id=\"nickname-input\" placeholder=\"e.g. CyberFox\" autocomplete=\"off\">\n                                <button id=\"btn-random-name\" class=\"btn btn-secondary btn-sm\" type=\"button\">\360\237\216\262 Randomize Nick</button>\n                            </div>\n                        </div>\n                        <div class=\"input-group\">\n                            <label for=\"nick-password-input\">NickServ Password (Optional)</label>\n                            <input type=\"password\" id=\"nick-password-input\" placeholder=\"For Registered Nicks\" autocomplete=\"off\" spellcheck=\"false\">\n                        </div>\n                    </div>\n\n                    <div class=\"button-group\">\n                        <button id=\"btn-create-room\" class=\"btn btn-primary\">\342\236\225 Create #channel</button>\n                        <button id=\"btn-join-room\" class=\"btn btn-secondary\">\360\237\232\200 Join #channel</button>\n                    </div>\n                </div>\n\n                <div id=\"room-share-section\" class=\"room-share hidden\">\n                    <p>\360\237\224\222 Shareable IRC Channel Link (domain.com/#&lt;channel&gt; scheme):</p>\n                    <div class=\"share-box\">\n                        <input type=\"text\" id=\"share-url\" readonly>\n                        <button id=\"btn-copy-link\" class=\"btn btn-primary btn-sm\">\360\237\223\213 Copy Channel Link</button>\n                    </div>\n                </div>\n            </section>\n\n            <!-- Video Stage Area -->\n            <section id=\"video-stage\" class=\"card video-card hidden\">\n                <div class=\"video-grid\" id=\"video-grid\">\n                    <!-- Local Self Video Container -->\n                    <div class=\"video-wrapper local-wrapper\">\n                        <video id=\"local-video\" autoplay playsinline muted></video>\n                        <div class=\"video-label\">\n                            <span class=\"dot live-dot\"></span> <span id=\"local-name-label\">You</span>\n                        </div>\n                    </div>\n\n                    <!-- Remote Peer Video Container -->\n                    <div class=\"video-wrapper remote-wrapper\" id=\"remote-wrapper\">\n                        <video id=\"remote-video\" autoplay playsinline></video>\n                        <div class=\"video-placeholder\" id=\"remote-placeholder\">\n                            <div class=\"pulse-ring\"></div>\n                            <span class=\"placeholder-icon\">\360\237\221\244</span>\n                            <p id=\"remote-status-text\">Waiting for peer to join channel...</p>\n                        </div>\n                        <div class=\"video-label\" id=\"remote-label\">\n                            <span class=\"dot\"></span> <span id=\"remote-name-label\">Remote Peer</span>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Call Control Toolbar -->\n                <div class=\"call-controls\">\n                    <button id=\"btn-toggle-mic\" class=\"btn-control\" title=\"Mute Microphone\" aria-label=\"Mute Microphone\" aria-pressed=\"false\">\n                        <span class=\"icon\" aria-hidden=\"true\">\360\237\216\231\357\270\217</span>\n                    </button>\n                    <button id=\"btn-toggle-cam\" class=\"btn-control\" title=\"Turn Off Camera\" aria-label=\"Turn Off Camera\" aria-pressed=\"false\">\n                        <span class=\"icon\" aria-hidden=\"true\">\360\237\223\271</span>\n                    </button>\n                    <button id=\"btn-share-screen\" class=\"btn-control\" title=\"Share Screen\" aria-label=\"Share Screen\" aria-pressed=\"false\">\n                        <span class=\"icon\" aria-hidden=\"true\">\360\237\226\245\357\270\217</span>\n                    </button>\n                    <button id=\"btn-leave-call\" class=\"btn-control btn-danger\" title=\"Leave Channel\" aria-label=\"Leave Channel\">\n                        <span class=\"icon\" aria-hidden=\"true\">\360\237\223\236</span> Leave Channel\n                    </button>\n                </div>\n            </section>\n\n            <!-- Text & DataChannel Chat Panel with IRC User List -->\n            <section id=\"chat-panel\" class=\"card chat-card hidden\">\n                <div class=\"chat-header\">\n                    <div>\n                        <h3 id=\"chat-channel-title\">\360\237\222\254 #lobby (P2P DataChannel Chat)</h3>\n                        <div id=\"channel-topic-bar\" class=\"channel-topic\">Topic: Welcome to IVC IRC WebRTC!</div>\n                    </div>\n                    <span class=\"chat-security-label\">\360\237\224\222 End-to-End Encrypted</span>\n                </div>\n                <div class=\"chat-body-container\">\n                    <div id=\"chat-messages\" class=\"chat-messages\">\n                        <div class=\"system-message\">\n                            Channel initialized. Type <code>/help</code> for IRC commands or <code>/theme &lt;name&gt;</code> for themes.\n                        </div>\n                    </div>\n                    <div class=\"sidebar-container\">\n                        <div class=\"sidebar-tabs\">\n                            <button id=\"tab-nicks\" class=\"sidebar-tab active\">Nicks</button>\n                            <button id=\"tab-gallery\" class=\"sidebar-tab\">Gallery</button>\n                        </div>\n                        <div id=\"user-list-sidebar\" class=\"user-list-sidebar\">\n                            <h4>Nicks in Channel</h4>\n                            <ul id=\"user-list\" class=\"user-list\">\n                                <!-- Populated dynamically -->\n                            </ul>\n                        </div>\n                        <div id=\"gallery-sidebar\" class=\"gallery-sidebar hidden\">\n                            <h4>Media Gallery</h4>\n                            <div id=\"media-gallery\" class=\"media-gallery\">\n                                <!-- Populated dynamically -->\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"chat-input-area\">\n                    <input type=\"text\" id=\"chat-input\" placeholder=\"Type a message or IRC command (/msg CHANSERV, /theme, /op, /topic, /help)...\" autocomplete=\"off\">\n                    <button id=\"btn-attach-file\" class=\"btn btn-secondary\" title=\"Share File / Attachment\">\360\237\223\216 File</button>\n                    <input type=\"file\" id=\"chat-file-input\" class=\"hidden\">\n                    <button id=\"btn-send-chat\" class=\"btn btn-primary\">Send</button>\n                </div>\n            </section>\n\n            <!-- Special Connection Stats Room Stage (#stats) -->\n            <section id=\"stats-stage\" class=\"card stats-card hidden\">\n                <div class=\"stats-header\">\n                    <h2>\360\237\223\212 IRC Server & WebRTC Connection Stats (#stats)</h2>\n                    <button id=\"btn-refresh-stats\" class=\"btn btn-secondary btn-sm\">\360\237\224\204 Refresh Stats</button>\n                </div>\n\n                <div class=\"stats-grid\">\n                    <!-- Server / MySQL Stats Card -->\n                    <div class=\"stats-panel\">\n                        <h3>\360\237\214\220 IRC Infrastructure & MySQL Database</h3>\n                        <div id=\"server-stats-content\" class=\"stats-list\">\n                            <div class=\"stats-row\"><span class=\"stats-label\">Database Status:</span><span class=\"stats-value\">Checking...</span></div>\n                        </div>\n                    </div>\n\n                    <!-- Client WebRTC Connection Stats Card -->\n                    <div class=\"stats-panel\">\n                        <h3>\342\232\241 Client WebRTC Connection Metrics</h3>\n                        <div id=\"client-stats-content\" class=\"stats-list\">\n                            <div class=\"stats-row\"><span class=\"stats-label\">Open Channel Tabs:</span><span class=\"stats-value\">0</span></div>\n... (truncated)\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ES2020\",\n    \"lib\": [\"ES2020\"],\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"strict\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true,\n    \"resolveJsonModule\": true,\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"sourceMap\": true,\n    \"moduleResolution\": \"node\"\n  },\n  \"include\": [\"src/**/*\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\"]\n}\n\n```\n\n--- /wrapper/android/app/build.gradle ---\n```\nplugins {\n    id \'com.android.application\'\n}\n\nandroid {\n    namespace \'com.fortress.ivc\'\n    compileSdk 34\n\n    defaultConfig {\n        applicationId \"com.fortress.ivc\"\n        minSdk 24\n        targetSdk 34\n        versionCode 1\n        versionName \"1.0\"\n    }\n\n    buildTypes {\n        release {\n            minifyEnabled false\n            proguardFiles getDefaultProguardFile(\'proguard-android-optimize.txt\'), \'proguard-rules.pro\'\n        }\n    }\n    compileOptions {\n        sourceCompatibility JavaVersion.VERSION_1_8\n        targetCompatibility JavaVersion.VERSION_1_8\n    }\n}\n\ndependencies {\n    implementation \'androidx.appcompat:appcompat:1.6.1\'\n    implementation \'com.google.android.material:material:1.11.0\'\n}\n\n```\n\n--- /wrapper/android/build.gradle ---\n```\nbuildscript {\n    repositories {\n        google()\n        mavenCentral()\n    }\n    dependencies {\n        classpath \'com.android.tools.build:gradle:8.1.1\'\n    }\n}\n\nallprojects {\n    repositories {\n        google()\n        mavenCentral()\n    }\n}\n\n```"
    }
  }
}
