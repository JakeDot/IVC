  file_change {
    absolute_path_uri: "file:///server.js"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\n\nconst app = express();\napp.use(express.json());\napp.use(express.static(\'public\'));\n\nconst port = 3000;\nconst host = \'0.0.0.0\';\n\n// In-memory data\nconst rooms = new Map(); // roomId -> { peers: Map<clientId, { response: res }> }\n\napp.get(\'/api/config.php\', (req, res) => {\n    res.json({ stun: [], turn: [] });\n});\n\napp.get(\'/api/stats.php\', (req, res) => {\n    res.json({ db_status: \'Mocked\', active_rooms: rooms.size });\n});\n\napp.get(\'/api/signal.php\', (req, res) => {\n    const roomId = req.query.room;\n    const clientId = req.query.client;\n    const mode = req.query.mode;\n\n    if (!roomId || !clientId) return res.status(400).json({ error: \'Missing room or client\' });\n\n    if (mode === \'sse\') {\n        res.setHeader(\'Content-Type\', \'text/event-stream\');\n        res.setHeader(\'Cache-Control\', \'no-cache\');\n        res.setHeader(\'Connection\', \'keep-alive\');\n        \n        if (!rooms.has(roomId)) {\n            rooms.set(roomId, { peers: new Map() });\n        }\n        rooms.get(roomId).peers.set(clientId, res);\n        \n        req.on(\'close\', () => {\n            if (rooms.has(roomId)) {\n                rooms.get(roomId).peers.delete(clientId);\n            }\n        });\n    } else {\n        res.json({ status: \'ok\', peers: [], messages: [] });\n    }\n});\n\napp.post(\'/api/signal.php\', (req, res) => {\n    const { room: roomId, client: clientId, type } = req.body;\n    \n    if (type === \'leave\') {\n        if (rooms.has(roomId)) {\n            rooms.get(roomId).peers.delete(clientId);\n        }\n        return res.json({ status: \'left\' });\n    }\n    \n    // Broadcast\n    if (rooms.has(roomId)) {\n        rooms.get(roomId).peers.forEach((peerRes, peerId) => {\n            if (peerId !== clientId) {\n                peerRes.write(`data: ${JSON.stringify(req.body)}\\n\\n`);\n            }\n        });\n    }\n    res.json({ status: \'sent\' });\n});\n\napp.post(\'/api/irc.php\', (req, res) => {\n    const { channel, nickname, command, params } = req.body;\n    // Mock IRC response\n    res.json({ success: true, message: `Executed ${command} via mock IRC server` });\n});\n\napp.get(\'/api/files.php\', (req, res) => {\n    res.json({ files: [] });\n});\napp.post(\'/api/files.php\', (req, res) => {\n    res.json({ success: true });\n});\n\n// Fallback all API missing to 501\napp.all(\'/api/*\', (req, res) => {\n    res.status(501).json({ error: \'Not yet migrated\' });\n});\n\napp.listen(port, host, () => {\n    console.log(`Server listening on port ${port}`);\n});\n"
    }
