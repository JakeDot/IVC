{
  "name": "@jakebot/the-fortress-template",
  "version": "1.0.0",
  "description": "Security-hardened project template with comprehensive IT security framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node server.js",
    "start": "node server.js",
    "test": "jest",
    "test:security": "jest tests/security",
    "test:penetrate": "jest tests/penetration",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "fortress:init": "node scripts/init-fortress.js",
    "threat:scan": "node scripts/threat-scan.js",
    "audit:full": "node scripts/full-audit.js",
    "deps:audit": "npm audit",
    "compliance:report": "node scripts/compliance-report.js",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "security",
    "fortress",
    "hardening",
    "encryption",
    "compliance",
    "threat-detection",
    "incident-response"
  ],
  "author": "JakeDot",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "brace-expansion": "2.1.7",
    "handlebars": "4.7.10",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "undici": "8.12.3",
    "eslint": {
      "js-yaml": "4.3.2"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    }
  },
  "dependencies": {
    "@php-wasm/node": "^3.1.50",
    "better-sqlite3": "^13.0.3",
    "events": "^3.3.0",
    "express": "^5.2.1",
    "jsdom": "^30.0.1",
    "php-wasm": "^0.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^3.1.2",
      "body-parser": "2.4.0",
      "brace-expansion": "2.1.7",
      "handlebars": "4.7.10",
      "proxy-addr": "2.0.8",
      "qs": "6.16.1",
      "source-map-js": "1.2.2",
      "undici": "8.12.3",
      "eslint>js-yaml": "4.3.2",
      "@eslint/eslintrc>js-yaml": "4.3.2",
      "@istanbuljs/load-nyc-config>js-yaml": "3.15.2"
    }
  }
}